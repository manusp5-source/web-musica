# Copia este fichero como .env y rellena los valores reales.
# .env está en .gitignore: nunca se commitea con datos reales.
# Guía paso a paso para conseguir cada uno de estos valores: docs/google-business-setup.md

# --- OAuth 2.0 (nivel 1 — nunca en el repo) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Ubicación de la ficha en Business Profile (nivel 2) ---
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# --- Enlace público de la ficha, para "Ver todas en Google" (nivel 2) ---
GBP_PROFILE_URL=

# --- Solo para tests e2e: apaga el hero 3D (nivel 2, no es secreto) ---
# NEXT_PUBLIC_HERO3D=off
